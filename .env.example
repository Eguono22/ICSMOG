# ICSMOG environment variables
# Copy this file to .env and set values before running.
# The .env file is loaded automatically by main.py and by docker-compose.

# ── Server ────────────────────────────────────────────────────────────────────
# Host interface. Use 0.0.0.0 to accept connections from all interfaces
# (required inside Docker). Use 127.0.0.1 for local-only access.
ICSMOG_HOST=0.0.0.0

# TCP port the API listens on.
ICSMOG_PORT=8000

# Path to the SQLite database file. Mount this path as a volume in Docker
# to persist data across container restarts.
ICSMOG_STORAGE_PATH=/app/data/cybersecurity.db

# ── Bootstrap operator credentials ────────────────────────────────────────────
# These keys are used ONCE to seed the first analyst and admin accounts when
# the database is empty. After the accounts are created they persist in the
# database; changing these values will NOT update existing accounts.
#
# IMPORTANT: change both values before first run in any non-demo environment.
ICSMOG_ANALYST_KEY=change-me-analyst-key
ICSMOG_ADMIN_KEY=change-me-admin-key
